Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 400
  - Class: rviz_common/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map (/map, slam brick)
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: true
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Robot (where SLAM puts it)
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Show Names: true
      Value: false
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LaserScan (/scan)
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Size (m): 0.05
      Style: Flat Squares
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Trail - truth (green)
      Topic:
        Value: /trail/truth
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Line Style: Billboards
      Line Width: 0.05
      Color: 40; 220; 60
      Alpha: 1
      Buffer Length: 1
      Pose Style: None
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Trail - wheel odometry (red)
      Topic:
        Value: /trail/raw
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Line Style: Billboards
      Line Width: 0.05
      Color: 255; 60; 60
      Alpha: 1
      Buffer Length: 1
      Pose Style: None
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Trail - EKF (blue)
      Topic:
        Value: /trail/ekf
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Line Style: Billboards
      Line Width: 0.05
      Color: 60; 140; 255
      Alpha: 1
      Buffer Length: 1
      Pose Style: None
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 55
      X: 3.0
      Y: 0.4
      Angle: 0
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 860
  Width: 1500
  X: 150
  Y: 80
