Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 2
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Drone path (/drone/odom)
      Enabled: true
      Keep: 300
      Shape:
        Value: Axes
        Axes Length: 0.5
        Axes Radius: 0.05
      Topic:
        Value: /drone/odom
        Depth: 5
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Front camera
      Enabled: true
      Topic:
        Value: /drone/front/image_raw
        Depth: 2
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Front depth (m)
      Enabled: true
      Normalize Range: false
      Min Value: 0
      Max Value: 30
      Topic:
        Value: /drone/front/depth
        Depth: 2
        Reliability Policy: Reliable
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Focal Point: {X: 0, Y: 0, Z: 3}
      Pitch: 0.6
      Yaw: 3.9
      Name: Current View
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1500
